# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 16 required: pg_trgm extension is mandatory)
DATABASE_URL=postgres://llmmarket:llmmarket@localhost:5432/llmmarket

# Redis (Celery broker + Django cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email
DEFAULT_FROM_EMAIL=hello@llmappmarket.com
SUBMISSIONS_NOTIFY_EMAILS=editor@llmappmarket.com
AGENT_REVIEW_DIGEST_EMAILS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CORS — never use CORS_ALLOW_ALL_ORIGINS=True in production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry
SENTRY_DSN=

# MCP Registry
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io/v1

### LLM
AGENT_LLM_PROVIDER_PRIMARY=openai
AGENT_LLM_MODEL_PRIMARY=<model-name>
OPENAI_API_KEY=<your-key>
AGENT_OPENAI_INPUT_COST_PER_1M_TOKENS=0
AGENT_OPENAI_OUTPUT_COST_PER_1M_TOKENS=0
AGENT_MONTHLY_BUDGET_USD=20
AGENT_SOURCES_ENABLED=
GITHUB_TOKEN=



# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
# Dev: any non-empty string. Prod (config.settings.prod): must be a real
# high-entropy value — the prod settings module refuses to boot with the
# insecure default below or with an empty value.
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 16 required: pg_trgm extension is mandatory)
DATABASE_URL=postgres://llmmarket:llmmarket@localhost:5432/llmmarket

# Redis (Celery broker + Django cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email
DEFAULT_FROM_EMAIL=hello@llmappmarket.com
SUBMISSIONS_NOTIFY_EMAILS=editor@llmappmarket.com
AGENT_REVIEW_DIGEST_EMAILS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CORS — never use CORS_ALLOW_ALL_ORIGINS=True in production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF — comma-separated list of trusted origins for cross-origin form/XHR
# submissions in production. Same-origin requests are always trusted.
# Example: https://llmappmarket.com,https://www.llmappmarket.com
CSRF_TRUSTED_ORIGINS=

# Public base URL for the site — used to build absolute links inside
# admin emails (review queue digest, budget alerts, etc.). Must include
# scheme + host, no trailing slash.
SITE_BASE_URL=https://llmappmarket.com

# Force Celery to run tasks synchronously in the calling process. Default
# False (workers consume from Redis). manage.py agent_run auto-flips this
# in process when the broker is unreachable from a host venv; setting it
# in the environment is for full-eager test runs only.
CELERY_TASK_ALWAYS_EAGER=False

# Per-domain rate limit for the agent's polite-client fetcher (RSS,
# GitHub MCP search/contents, fetch_url_text). Enforced by the
# process-wide DomainRateLimiter (apps/agent/pipeline/rate_limit.py).
# Default 1.0 = 1 RPS; raise for authenticated GitHub (token = 30 search
# RPM + 5000 contents/h tolerates higher).
AGENT_RATE_LIMIT_RPS_PER_DOMAIN=1.0

# Editor SLA window for /admin/agent/needsreviewqueueentry/sla-dashboard/.
# Pending review-queue entries older than this many days are flagged
# "overdue" on the dashboard. Default 14 days.
AGENT_REVIEW_QUEUE_SLA_DAYS=14

# Retention windows for the unbounded audit-trail tables. Sunday-night
# cleanup tasks (04:00-04:45 UTC) trim rows older than these cutoffs.
#   * AGENT_LOG_RETENTION_DAYS — deletes AgentRun rows; EnrichmentTask
#     and LLMCallLog cascade via FK. Pending NeedsReviewQueueEntry rows
#     are preserved regardless of age (editor work is never dropped).
#   * SOURCES_LINK_CHECK_RETENTION_DAYS — trims LinkCheckResult only;
#     LinkHealth is a rolling summary and is never deleted.
#   * SEARCH_LOG_RETENTION_DAYS — trims SearchLog. PopularSearch is
#     rebuilt from the trailing 30-day window, so 90 days is safe.
# ClickEvent / PageView retention lives on a separate
# analytics-specific cleanup (cleanup_old_analytics_data, 90d, also
# beat-scheduled — not env-tunable yet).
AGENT_LOG_RETENTION_DAYS=180
SOURCES_LINK_CHECK_RETENTION_DAYS=30
SEARCH_LOG_RETENTION_DAYS=90

# Superuser bootstrap (optional). When ALL THREE are set, the docker
# entrypoint creates a superuser on first boot if none exists. If unset,
# bootstrap is skipped — create one with `manage.py createsuperuser`.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Sentry
SENTRY_DSN=

# MCP Registry
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io/v0
GEMINI_EXTENSIONS_URL=https://geminicli.com/extensions.json
CLAUDE_CONNECTORS_BASE_URL=https://claude.com/connectors
CHATGPT_APPS_INDEX_URL=https://mcpapp.net/chatgpt-apps

### LLM
AGENT_LLM_PROVIDER_PRIMARY=openai
AGENT_LLM_MODEL_PRIMARY=gpt-5.4-mini
AGENT_LLM_PROVIDER_CHEAP=openai
AGENT_LLM_MODEL_CHEAP=gpt-5.4-nano
OPENAI_API_KEY=<your-key>

# Per-role + per-channel prices in USD per 1M tokens. Primary is the full
# enrichment model (e.g. gpt-5.4-mini); cheap is the discovery classifier
# (e.g. gpt-5.4-nano). Cached input is billed at ~10% of the standard
# input rate when prompt-cache hits occur; _estimate_cost_usd subtracts
# cached from billable input before applying the cached-input price.
# Defaults below match OpenAI's public pricing snapshot — update when the
# vendor changes prices.
AGENT_OPENAI_PRIMARY_INPUT_COST_PER_1M_TOKENS=0.75
AGENT_OPENAI_PRIMARY_CACHED_COST_PER_1M_TOKENS=0.075
AGENT_OPENAI_PRIMARY_OUTPUT_COST_PER_1M_TOKENS=4.50
AGENT_OPENAI_CHEAP_INPUT_COST_PER_1M_TOKENS=0.20
AGENT_OPENAI_CHEAP_CACHED_COST_PER_1M_TOKENS=0.02
AGENT_OPENAI_CHEAP_OUTPUT_COST_PER_1M_TOKENS=1.25

AGENT_MONTHLY_BUDGET_USD=20
# Optional dedicated recipients for the budget alert at 80% / 100%.
# Falls back to AGENT_REVIEW_DIGEST_EMAILS → SUBMISSIONS_NOTIFY_EMAILS.
AGENT_BUDGET_ALERT_EMAILS=

# CSV. Valid keys: rss, github_mcp, gemini_extensions, claude_connectors,
# chatgpt_apps, enrich_pending.
AGENT_SOURCES_ENABLED=

# Phase 4 re-actualization. Daily beat at 07:00 UTC re-fetches and
# re-enriches published apps whose freshest source is older than
# AGENT_REACTUALIZATION_INTERVAL_DAYS, queueing drift to the editor's
# NeedsReviewQueue. Off by default; flip ENABLED=True in prod once the
# pipeline has been dry-run-validated. dry_run=True bypasses the flag.
AGENT_REACTUALIZATION_ENABLED=False
AGENT_REACTUALIZATION_INTERVAL_DAYS=30
AGENT_REACTUALIZATION_BATCH_SIZE=20

GITHUB_TOKEN=


#AGENT_LLM_PROVIDER_PRIMARY=anthropic
#AGENT_LLM_MODEL_PRIMARY=<model-name>
#ANTHROPIC_API_KEY=<your-key>

#AGENT_MONTHLY_BUDGET_USD=20
#AGENT_SOURCES_ENABLED=

# GitHub Search / Contents API token (Phase 3 github_mcp source).
# Unauthenticated: 10 req/min on search; authenticated: 30 req/min on search
# + 5000 req/h on contents. Fine-grained PAT with read-only public-repo scope
# is sufficient.
#GITHUB_TOKEN=

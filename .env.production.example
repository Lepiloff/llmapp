# Production environment template for a single EC2 host.
# Copy to .env on the server. Never commit the resulting .env file.

# Django
DEBUG=False
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING
DJANGO_SETTINGS_MODULE=config.settings.prod
SITE_DOMAIN=llmappmarket.com
ALLOWED_HOSTS=llmappmarket.com,www.llmappmarket.com
CSRF_TRUSTED_ORIGINS=https://llmappmarket.com,https://www.llmappmarket.com
CORS_ALLOWED_ORIGINS=
SITE_NAME=LLM App Market
SITE_BASE_URL=https://llmappmarket.com

# Single-EC2 PostgreSQL and Redis. POSTGRES_PASSWORD and DATABASE_URL must
# carry the same generated password.
POSTGRES_DB=llmmarket
POSTGRES_USER=llmmarket
POSTGRES_PASSWORD=CHANGE-THIS-TO-A-LONG-RANDOM-DB-PASSWORD
DATABASE_URL=postgres://llmmarket:CHANGE-THIS-TO-A-LONG-RANDOM-DB-PASSWORD@postgres:5432/llmmarket
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Optional superuser bootstrap. Remove the password from .env after the first
# successful boot and recreate the containers with `docker compose up -d`.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Email
DEFAULT_FROM_EMAIL=hello@llmappmarket.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SUBMISSIONS_NOTIFY_EMAILS=
AGENT_REVIEW_DIGEST_EMAILS=
AGENT_BUDGET_ALERT_EMAILS=

# External sources
MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io/v0
GEMINI_EXTENSIONS_URL=https://geminicli.com/extensions.json
CLAUDE_CONNECTORS_BASE_URL=https://claude.com/connectors
CHATGPT_APPS_INDEX_URL=https://mcpapp.net/chatgpt-apps
GITHUB_TOKEN=

# Cloudflare Turnstile and Sentry
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SENTRY_DSN=

# Agent pipeline. Keep sources disabled through the first smoke checks and
# bootstrap. Enable the CSV list only after reviewing the first imported drafts.
AGENT_LLM_PROVIDER_PRIMARY=openai
AGENT_LLM_MODEL_PRIMARY=gpt-5.4-mini
AGENT_LLM_PROVIDER_CHEAP=openai
AGENT_LLM_MODEL_CHEAP=gpt-5.4-nano
OPENAI_API_KEY=
AGENT_OPENAI_PRIMARY_INPUT_COST_PER_1M_TOKENS=0.75
AGENT_OPENAI_PRIMARY_CACHED_COST_PER_1M_TOKENS=0.075
AGENT_OPENAI_PRIMARY_OUTPUT_COST_PER_1M_TOKENS=4.50
AGENT_OPENAI_CHEAP_INPUT_COST_PER_1M_TOKENS=0.20
AGENT_OPENAI_CHEAP_CACHED_COST_PER_1M_TOKENS=0.02
AGENT_OPENAI_CHEAP_OUTPUT_COST_PER_1M_TOKENS=1.25
AGENT_MONTHLY_BUDGET_USD=20
# Valid values: rss,github_mcp,gemini_extensions,claude_connectors,
# chatgpt_apps,enrich_pending
AGENT_SOURCES_ENABLED=
# Source.source_type allowlist for scheduled enrich_pending. Default excludes
# mcp_registry; set to "all" only for a budget-approved MCP enrichment run.
AGENT_ENRICH_PENDING_SOURCE_TYPES=gemini_extensions,claude_connectors,chatgpt_unofficial
AGENT_REACTUALIZATION_ENABLED=False
AGENT_REACTUALIZATION_INTERVAL_DAYS=30
AGENT_REACTUALIZATION_BATCH_SIZE=20
AGENT_RATE_LIMIT_RPS_PER_DOMAIN=1.0

# Off-host PostgreSQL backups
PG_BACKUP_RETENTION_DAYS=14
PG_BACKUP_INTERVAL_SECONDS=86400
PG_BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Audit-log retention
AGENT_LOG_RETENTION_DAYS=180
SOURCES_LINK_CHECK_RETENTION_DAYS=30
SEARCH_LOG_RETENTION_DAYS=90
